# Local development only. The published app reads these from Cursor secrets,
# not from a file on the build machine.

# At least 8 characters. Unlocks the career-team desk as an admin.
ADMIN_PASSWORD=

# Optional second password. Unlocks the desk as a counsellor (no export or delete).
COUNSELLOR_PASSWORD=

# Google Sheet shared with the service account as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional. A full service-account JSON can be used instead of the email and key.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional public contact details.
CONTACT_EMAIL=skillvantageadmin@gmail.com
CONTACT_PHONE=+91 63032 20248
CONTACT_WHATSAPP=916303220248
CONTACT_LOCATION=Hyderabad, India
CONTACT_LOCATION_DETAIL=

# MongoDB connection string. When this is set, every desk record is stored in MongoDB.
MONGODB_URI=
# Optional database name. Defaults to skilvantage.
MONGODB_DB=skilvantage

# Provided automatically when the published app has a Postgres database.
# DATABASE_URL=
